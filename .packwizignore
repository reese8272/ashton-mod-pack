# .packwizignore uses .gitignore syntax: https://git-scm.com/docs/gitignore
# Anything matched here is excluded from the pack index, so it is never shipped
# to players and never overwritten on their machines.

# --- Repo files that are not part of the pack ---------------------------------
/README.md
/LEFT_OFF.md
/LICENSE
/docs/
/.github/
/scripts/
/tests/
# Claude Code project tooling and linter caches — packwiz does NOT default-ignore
# dotdirs (verified against packwiz core/index.go ignoreDefaults, 2026-08-02)
/.claude/
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
# local machine path remembered by sync_from_instance.py -- .gitignore does not
# cover this, packwiz has its own ignore file and would otherwise ship it
/.sync-instance-path
/.git/
# locally-assembled server pack; ~500 MB and NOT for players
/build/

# --- PER-PLAYER SETTINGS: THE KEYBIND FIX -------------------------------------
# Shipping any of these overwrites each player's own settings on every update.
# Pack-wide defaults are delivered by the Default Options mod (/defaultoptions)
# instead, which applies them on FIRST LAUNCH ONLY and never again.
/options.txt
/optionsof.txt
/optionsshaders.txt
/servers.dat
/servers.dat_old
/servers.essential.dat
/usercache.json
/usernamecache.json
/command_history.txt
/ponders_watched.json
/realms_persistence.json
/hotbar.nbt

# Per-player map data and waypoints
/xaero/
/XaeroWaypoints*/
/XaeroWorldMap*/

# Essential account/session data — per player, and contains credentials
/essential/

# --- PLAYER WORLDS AND LOCAL OUTPUT -------------------------------------------
/saves/
/backups/
/screenshots/
/logs/
/crash-reports/
/debug/
/.mixin.out/

# --- RUNTIME STATE UNDER config/ ----------------------------------------------
# Mods rewrite these while the game runs; shipping them pushes one player's
# state onto everyone and permanently diverges from the indexed hash.
# verify_pack.py bans this whole class (BANNED_CONFIG_*).
/config/spark/activity.json
/config/spark/tmp/
/config/spark/tmp-client/
/config/bountiful/errors.log
/config/fancymenu/user_variables.db
/config/fancymenu/video_element_controller_metas.json
/config/fancymenu/layout_editor/
/config/jei/world/
/config/inventoryprofilesnext/New World/
/config/inventoryprofilesnext/P3T/
/config/voicechat/category-volumes.properties
*.bak

# --- REGENERABLE CACHES -------------------------------------------------------
# These are rebuilt at runtime. fancymenu_temp alone is ~455 MB of decoded
# intro video; shipping it would triple the download for zero benefit.
/fancymenu_data/fancymenu_temp/
/config/fancymenu/assets/
/cache/
/immersive_paintings_cache/
/dynamic-resource-pack-cache/
/dynamic-data-pack-cache/
/particular_cache/
/patched_shaders/
/mods/.connector/
/mods/.index/
/.sable/
/bivrik/

# --- Distant Horizons LOD databases (per-world, can reach many GB) ------------
**/data/DistantHorizons.sqlite*
/data/

# --- Python bytecode -----------------------------------------------------------
# packwiz reads THIS file, not .gitignore. verify_pack.py imports apply_sides, so
# running it leaves scripts/__pycache__ behind; it must never reach a player.
**/__pycache__/
*.pyc
